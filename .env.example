# Laboratory Management System Environment Configuration

# Database Configuration
SQLALCHEMY_URL=sqlite:///laboratory.sqlite
# For PostgreSQL: postgresql://user:password@localhost:5432/laboratory

# Authentication
AUTH_SECRET=your-very-secure-secret-key-change-this-in-production

# Admin User Configuration
ADMIN_EMAIL=admin@laboratory.local
ADMIN_PASSWORD=secure-admin-password

# Application Settings
PYRAMID_DEBUG=true
PYRAMID_RELOAD_TEMPLATES=true
PYRAMID_DEFAULT_LOCALE_NAME=uk

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=6543

# Email Configuration (for notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=laboratory.log