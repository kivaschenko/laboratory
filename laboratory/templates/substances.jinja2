{% extends "layout.jinja2" %}

{% block content %}
<div class="content">
<a href="/substances/edit" class="btn btn-warning">{{ _('substances.edit_catalog') }}</a>
<hr>
<h1><span class="font-semi-bold">{{ _('substances.catalog_title') }}</span></h1>
<table class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>{{ _('substances.name') }}</th>
            <th>{{ _('substances.unit_measurement') }}</th>
        </tr>
    </thead>
    <tbody>
        {% if subs_list %}
            {% for subs in subs_list %}
        <tr>
            <td>{{ subs['id'] }}</td>
            <td>{{ subs['name'] }}</td>
            <td>{{ subs['measurement'] }}</td>
        </tr>
            {% endfor %}
        {% else %}
        <tr>{{ _('substances.no_items') }}</tr>
        {% endif %}
    </tbody>
</table>
</div>

{% endblock content %}
